{
  "opencollection": "1.0.0",
  "info": {
    "name": "LandTech Additional Opportunities Local Policy API",
    "version": "0.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Local Policy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Details about a single local plan policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.land.tech/api/local_plan_policy/:local_plan_policy_id",
            "params": [
              {
                "name": "local_plan_policy_id",
                "value": "",
                "type": "path",
                "description": "ID for a specific local plan policy"
              }
            ]
          },
          "docs": "Given a local policy ID, get details about a single local plan policy"
        },
        {
          "info": {
            "name": "Bulk - Details about local plan policies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.land.tech/api/local_plan_policy",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Given a set of local plan policy IDs, get details about local plan policies in bulk"
        },
        {
          "info": {
            "name": "Bulk - Details about local plan policies (without geometry)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.land.tech/api/local_plan_policy/lite",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Given a set of local plan policy IDs, get details about local plan policies in bulk without geometry data"
        }
      ]
    }
  ],
  "bundled": true
}